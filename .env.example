# Public browser configuration only. Copy to .env.local and replace both values.
# No database password, sb_secret_ key, or service-role key belongs here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public origin encoded into student links and QR codes. Use the deployed HTTPS origin.
VITE_PUBLIC_APP_URL=https://classroom-survey.pages.dev
